# fish-bot 环境变量示例（复制成 .env 或用 export 注入；勿提交真实值）

# DeepSeek 官方 API key（platform.deepseek.com → API keys）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# 模型（deepseek-chat / deepseek-reasoner）
DEEPSEEK_MODEL=deepseek-chat

# SnowLuma / NapCat 的 OneBot 正向 WebSocket
ONEBOT_WS=ws://127.0.0.1:3001
ONEBOT_TOKEN=<你的-onebot-token>

# 数据目录（记忆/角色状态/事件）；不设置时默认为仓库内的 data/naiwa
# FISH_HOME=./data/naiwa

# 可选：把收到的原始 OneBot 事件录制成 JSONL（含聊天原文，只存本地）
# ONEBOT_RECORD_FILE=./data/recordings/onebot-events.jsonl
