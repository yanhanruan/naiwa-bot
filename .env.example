# fish-bot 环境变量示例（复制成 .env 或用 export 注入；勿提交真实值）

# DeepSeek 官方 API key（platform.deepseek.com → API keys）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# 模型：deepseek-v4-pro（支持联网搜索）或 deepseek-flash（更便宜，不支持联网搜索）
DEEPSEEK_MODEL=deepseek-v4-pro

# 可选：模型调用的限制（见 docs/module-04-model.md）
# 每日花费上限（元，按官方价格估算），0 表示不限
# MODEL_DAILY_BUDGET_CNY=20
# 每个会话（群或私聊）每分钟、每小时最多调用几次，0 表示不限
# MODEL_RATE_PER_MINUTE=10
# MODEL_RATE_PER_HOUR=120
# 关闭联网搜索：off；思考强度：例如 none 关闭思考（更快、更省）
# DEEPSEEK_WEB_SEARCH=off
# DEEPSEEK_REASONING_EFFORT=none

# SnowLuma / NapCat 的 OneBot 正向 WebSocket
ONEBOT_WS=ws://127.0.0.1:3001
ONEBOT_TOKEN=<你的-onebot-token>

# PostgreSQL：docker compose 的 db 服务用 POSTGRES_PASSWORD 初始化；程序用 DATABASE_URL 连接
POSTGRES_PASSWORD=<随机生成的长密码>
DATABASE_URL=postgres://naiwa:<同上密码>@127.0.0.1:5432/naiwa
# 可选：真实 PostgreSQL 上的存储测试，必须指向专用测试库（测试会写入数据）
# TEST_DATABASE_URL=postgres://naiwa:<同上密码>@127.0.0.1:5432/naiwa_test

# 可选：日志级别（debug / info / warn / error，默认 info）和格式（pretty / json；不设置时终端里用 pretty，否则 json）
# LOG_LEVEL=info
# LOG_FORMAT=pretty

# 可选：把收到的原始 OneBot 事件录制成 JSONL（含聊天原文，只存本地）
# 平时不要开：录下的是所有群的全部消息，不会过期，按人删除也删不到。只在要做统计时临时开，用完删掉。
# ONEBOT_RECORD_FILE=./data/recordings/onebot-events.jsonl

# 可选：Docker Hub 拉不到时，改用其他镜像源的 PostgreSQL 18 镜像
# POSTGRES_IMAGE=postgres:18-alpine

# 可选：看懂图片（见 docs/image-understanding-design.md）。off 不看图，图片都按“[图片]”处理；引用带原文不受影响
# IMAGE_UNDERSTANDING=off
# 看图用的模型，默认 deepseek-flash（只有它能看图）
# IMAGE_MODEL=deepseek-flash
